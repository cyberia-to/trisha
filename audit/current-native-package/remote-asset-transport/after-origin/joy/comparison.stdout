c_budget_controls_native_confirmation ... ok\n+test prover_and_verifier_traits_bind_claim_without_legacy_downgrade ... ok\n+test unsupported_secret_state_and_call_inputs_are_refused ... ok\n+test compiled_source_roundtrip_and_changed_statement_rejection ... ok\n+\n+test result: ok. 5 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.01s\n+\n+\n+running 5 tests\n+test dynamic_self_application_hits_the_native_depth_guard ... ok\n+test binary_and_nary_formulas_share_the_noun_depth_ceiling ... ok\n+test malformed_raw_formula_returns_an_error_without_process_abort ... ok\n+test shared_result_expansion_is_checked_before_flat_output_allocation ... ok\n+test hash_consing_does_not_bypass_the_syntactic_node_ceiling ... ok\n+\n+test result: ok. 5 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 6.61s\n+\n+\n+running 3 tests\n+test missing_witnesses_are_refused_by_execution ... ok\n+test relabeling_legacy_statement_cannot_enable_another_format ... ok\n+test secret_execution_works_but_all_public_provers_refuse_witnesses ... ok\n+\n+test result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.35s\n+\n+\n+running 4 tests\n+test inactive_calls_do_not_consume_witnesses_and_nested_checks_preserve_order ... ok\n+test canonical_field_inputs_are_required_in_both_native_entry_points ... ok\n+test successful_execution_consumes_exactly_the_ordered_active_stream ... ok\n+test state_execution_enforces_the_same_stream_contract_for_hidden_reads ... ok\n+\n+test result: ok. 4 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.02s\n+\n+\n+running 2 tests\n+test terminal_branch_public_certificates_bind_selected_values ... ok\n+test terminal_branch_executes_secrets_without_public_proof_fallback ... ok\n+\n+test result: ok. 2 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.49s\n+\n+\n+running 3 tests\n+test aggregate_entry_has_real_proven_native_layout ... ok\n+test unused_typed_inputs_are_constrained_by_public_execution_certificate ... ok\n+test typed_input_guards_bind_native_private_execution ... ok\n+\n+test result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 8.09s\n+\n+\n+running 6 tests\n+test constructor_refuses_non_native_and_inconsistent_saved_jobs ... ok\n+test dispatch_association_profile_and_byte_limits_precede_decoding ... ok\n+test state_presence_cannot_be_downgraded_inside_the_shared_private_format ... ok\n+test tampered_public_results_are_rejected_by_the_selected_native_verifier ... ok\n+test all_profiles_verify_saved_computations_without_private_inputs ... ok\n+test valid_proofs_for_different_saved_expectations_are_rejected ... ok\n+\n+test result: ok. 6 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 3.18s\n+\n+\n+running 0 tests\n+\n+test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s\n+"},{"sha":"9ea093efa49df68817f646178e6a9aec5c4cda75","filename":"cli/tests/structured_certificates.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_certificates.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_certificates.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/cli%2Ftests%2Fstructured_certificates.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -1,4 +1,6 @@\n use serde_json::Value;\n+#[path = \"structured_certificates/deadline.rs\"]\n+mod deadline;\n use std::{\n     fs,\n     path::PathBuf,"},{"sha":"3b17ab4940fb06efdd691092b62b68cfdcb0bc43","filename":"cli/tests/structured_certificates/deadline.rs","status":"added","additions":97,"deletions":0,"changes":97,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_certificates%2Fdeadline.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_certificates%2Fdeadline.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/cli%2Ftests%2Fstructured_certificates%2Fdeadline.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -0,0 +1,97 @@\n+use super::*;\n+\n+#[test]\n+fn compiler_certificate_bytes_and_claim_survive_independent_host_deadlines() {\n+    let f = Fixture::new();\n+    f.compiler();\n+    let compact = [\n+        \"--resident-nodes\",\n+        \"196608\",\n+        \"--collection-work\",\n+        \"100000000\",\n+    ];\n+    let mut expected_proof = None;\n+    let mut expected_claim = None;\n+    for producer_ms in [\"30000\", \"7200000\", \"14400000\"] {\n+        let mut args = vec![\n+            \"prove-artifact\",\n+            \"compiler\",\n+            \"--input\",\n+            \"job\",\n+            \"-o\",\n+            \"proof\",\n+            \"--force\",\n+            \"--time-ms\",\n+            producer_ms,\n+        ];\n+        args.extend(compact);\n+        f.ok(&args);\n+        let proof = fs::read(f.0.join(\"proof\")).unwrap();\n+        if let Some(expected) = &expected_proof {\n+            assert_eq!(&proof, expected);\n+        } else {\n+            expected_proof = Some(proof);\n+        }\n+        for verifier_ms in [\"30000\", \"7200000\", \"14400000\"] {\n+            let mut args = vec![\n+                \"verify-artifact\",\n+                \"compiler\",\n+                \"--input\",\n+                \"job\",\n+                \"--proof\",\n+                \"proof\",\n+                \"-o\",\n+                \"compiled\",\n+                \"--emit\",\n+                \"program\",\n+                \"--force\",\n+                \"--time-ms\",\n+                verifier_ms,\n+            ];\n+            args.extend(compact);\n+            let verified = f.ok(&args);\n+            let mut claim = verified[\"verification\"].clone();\n+            claim.as_object_mut().unwrap().remove(\"elapsed_micros\");\n+            assert_eq!(claim[\"physical_resource_claim\"], \"unattested\");\n+            assert_eq!(claim[\"prover_observations\"], Value::Null);\n+            if let Some(expected) = &expected_claim {\n+                assert_eq!(&claim, expected);\n+            } else {\n+                expected_claim = Some(claim);\n+            }\n+            assert_eq!(\n+                fs::read(f.0.join(\"compiled\")).unwrap(),\n+                fs::read(f.0.join(\"generated\")).unwrap()\n+            );\n+            f.clean();\n+        }\n+    }\n+\n+    fs::write(f.0.join(\"destination\"), b\"previous\").unwrap();\n+    for command in [\"prove-artifact\", \"verify-artifact\"] {\n+        for time_ms in [\"0\", \"14400001\", \"18446744073709551615\"] {\n+            let mut args = vec![\n+                command,\n+                \"compiler\",\n+                \"--input\",\n+                \"job\",\n+                \"-o\",\n+                \"destination\",\n+                \"--force\",\n+                \"--time-ms\",\n+                time_ms,\n+            ];\n+            args.extend(compact);\n+            if command == \"verify-artifact\" {\n+                args.extend([\"--proof\", \"proof\"]);\n+            }\n+            let rejected = f.run(&args);\n+            assert_eq!(rejected.status.code(), Some(1));\n+            assert!(rejected.stdout.is_empty());\n+            assert!(String::from_utf8_lossy(&rejected.stderr)\n+                .contains(\"limit time_ms must be in 1..=14400000\"));\n+            assert_eq!(fs::read(f.0.join(\"destination\")).unwrap(), b\"previous\");\n+            f.clean();\n+        }\n+    }\n+}"},{"sha":"91dfcb496c4e22a66907e4c9ec5d0673d4ab4e67","filename":"cli/tests/structured_run.rs","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_run.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/cli%2Ftests%2Fstructured_run.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/cli%2Ftests%2Fstructured_run.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -238,7 +238,7 @@ fn explicit_compaction_deadline_ceiling_preserves_execution_and_publication() {\n             .unwrap()\n             > 1\n     );\n-    for time_ms in [\"3600000\", \"7200000\"] {\n+    for time_ms in [\"3600000\", \"7200000\", \"14400000\"] {\n         let mut args = flags.to_vec();\n         args.extend([\"--force\", \"--time-ms\", time_ms]);\n         let result = f.ok(&args);\n@@ -259,12 +259,12 @@ fn explicit_compaction_deadline_ceiling_preserves_execution_and_publication() {\n         );\n     }\n     let mut args = flags.to_vec();\n-    args.extend([\"--force\", \"--time-ms\", \"7200001\"]);\n+    args.extend([\"--force\", \"--time-ms\", \"14400001\"]);\n     let rejected = f.run(&args);\n     assert_eq!(rejected.status.code(), Some(1));\n     assert!(rejected.stdout.is_empty());\n     assert!(\n-        String::from_utf8_lossy(&rejected.stderr).contains(\"limit time_ms must be in 1..=7200000\")\n+        String::from_utf8_lossy(&rejected.stderr).contains(\"limit time_ms must be in 1..=14400000\")\n     );\n     assert_eq!(\n         fs::read(f.path.join(\"out.dag\")).unwrap(),"},{"sha":"8f3179d5cdc06eb784b2186a077e9f7084418294","filename":"rs/structured/limits.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Flimits.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Flimits.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/rs%2Fstructured%2Flimits.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -11,7 +11,7 @@ pub struct CompactionPolicy {\n const COMPACT_ALLOCATIONS: u64 = 1_000_000_000;\n const COMPACT_REDUCTIONS: u64 = 20_000_000_000;\n const COMPACT_WORK: u64 = 10_000_000_000;\n-const COMPACT_TIME_MS: u64 = 7_200_000;\n+const COMPACT_TIME_MS: u64 = 14_400_000;\n \n #[derive(Debug, Clone, Copy)]\n pub struct RunLimits {"},{"sha":"900fd0b8d5b659729537210da08952c66f351ff9","filename":"rs/structured/tests/compaction.rs","status":"modified","additions":12,"deletions":2,"changes":14,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Ftests%2Fcompaction.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Ftests%2Fcompaction.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/rs%2Fstructured%2Ftests%2Fcompaction.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -154,7 +154,7 @@ fn extended_caps_require_explicit_compaction_and_remain_bounded() {\n     let maximum = RunLimits {\n         arena_nodes: 1_000_000_000,\n         budget: 20_000_000_000,\n-        time_ms: 7_200_000,\n+        time_ms: 14_400_000,\n         compaction: Some(CompactionPolicy {\n             resident_nodes: MAX_ARENA_NODES,\n             collection_work: 10_000_000_000,\n@@ -238,7 +238,7 @@ fn explicit_compaction_deadlines_preserve_defaults_and_cancellation() {\n     .validate()\n     .is_err());\n \n-    for time_ms in [3_600_000, 7_200_000] {\n+    for time_ms in [3_600_000, 7_200_000, 14_400_000] {\n         RunLimits {\n             time_ms,\n             ..limits()\n@@ -247,6 +247,16 @@ fn explicit_compaction_deadlines_preserve_defaults_and_cancellation() {\n         .unwrap();\n     }\n \n+    for time_ms in [0, 14_400_001, u64::MAX] {\n+        let error = RunLimits {\n+            time_ms,\n+            ..limits()\n+        }\n+        .validate()\n+        .unwrap_err();\n+        assert_eq!(error, \"limit time_ms must be in 1..=14400000\");\n+    }\n+\n     // A short expired worker start exercises evaluator cancellation without\n     // requiring a clock that can represent times hours before process startup.\n     let run_limits = RunLimits {"},{"sha":"45bc70ecdaf316738564921ce61878145bcddb33","filename":"rs/structured/tests/compiler/compaction.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Ftests%2Fcompiler%2Fcompaction.rs","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/rs%2Fstructured%2Ftests%2Fcompiler%2Fcompaction.rs","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/rs%2Fstructured%2Ftests%2Fcompiler%2Fcompaction.rs?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -31,7 +31,7 @@ fn compiler_job_binding_and_extracted_artifact_survive_repeated_collection() {\n         result.report.charged_reductions,\n         ordinary.report.charged_reductions\n     );\n-    for time_ms in [3_600_000, 7_200_000] {\n+    for time_ms in [3_600_000, 7_200_000, 14_400_000] {\n         let at_deadline = run(\n             encoded(&ar, compiler),\n             encoded(&ar, job),"},{"sha":"459d055637c597b33d3737818a3ebf269215b6a1","filename":"specs/structured-run.md","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/cyberia-to/joy/blob/dd61df9128f6da1f97d4698f45f154f05312fe51/specs%2Fstructured-run.md","raw_url":"https://github.com/cyberia-to/joy/raw/dd61df9128f6da1f97d4698f45f154f05312fe51/specs%2Fstructured-run.md","contents_url":"https://api.github.com/repos/cyberia-to/joy/contents/specs%2Fstructured-run.md?ref=dd61df9128f6da1f97d4698f45f154f05312fe51","patch":"@@ -88,7 +88,7 @@ allocations, including loaded nodes and allocations left by failed operations.\n Hash-cons hits in the current arena are free. Reconstructing a previously\n collected value charges again. This is a conservative allocation allowance,\n separate from resident storage; no collection replenishes it. The host ceiling\n-is 1,000,000,000 allocations, 20,000,000,000 reductions and 7,200,000 ms in this\n+is 1,000,000,000 allocations, 20,000,000,000 reductions and 14,400,000 ms in this\n explicit mode. Defaults remain unchanged. All transport, frame and compiler\n schema ceilings remain unchanged. No JOB1 field or source option is added.\n `--budget` explicitly selects the reduction allowance within this ceiling;\n@@ -100,6 +100,11 @@ the default remains 30,000 ms and ordinary execution retains its 300,000 ms\n ceiling. Selecting a longer deadline leaves every work and storage allowance\n unchanged. The worker still joins before returning a cancellation failure,\n and cancellation preserves the destination without publishing a result.\n+The same explicit deadline policy applies to `prove-artifact` and\n+`verify-artifact`. Each process selects its own deadline; elapsed time remains\n+a host observation outside the certificate context. Certificate verification\n+therefore permits a different deadline from its producer while enforcing the\n+same expected program, input and logical claim.\n \n Resident nodes must be positive and at most 3,145,728. Physical tier selection\n uses this resident bound, capped by the cumulative allowance. JOB1 admission"}]}
working-tree inputs with all recorded RAM fixes; sources.json identifies every byte and the original repository revisions. Build, installed execution/proof, interoperability and Neptune gates must pass before final publication.\\n\\nSource SHA-256: c608b2fabae54c84acc81ac900070745b7b401626162921ed9a7b550bb989bb0.\\n\"}\n\\ No newline at end of file"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"audit/native-distribution-20261002/local-package-transport/binary-upload.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stderr","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stderr","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stderr?ref=68278000bc7941b8df74e6635925f7d08153360c"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"audit/native-distribution-20261002/local-package-transport/binary-upload.stdout","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stdout","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stdout","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fbinary-upload.stdout?ref=68278000bc7941b8df74e6635925f7d08153360c"},{"sha":"be6edfd7ad6be4705aedcd5130760fb6c52f0760","filename":"audit/native-distribution-20261002/local-package-transport/check-origin-after-packages.py","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-after-packages.py","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-after-packages.py","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-after-packages.py?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1,30 @@\n+from pathlib import Path\n+from concurrent.futures import ThreadPoolExecutor\n+import datetime,json,subprocess\n+ROOT=Path(__file__).resolve().parent.parent\n+OUT=ROOT/'measurements/after-package-origin';OUT.mkdir()\n+spec=json.loads((ROOT/'trisha-native-ci/.github/native-rehearsal-source.json').read_text())\n+def run(entry):\n+ repo=entry['repository'];path=OUT/repo;path.mkdir()\n+ cmd=['git','-C',str(ROOT/repo),'ls-remote','--heads','origin']\n+ result=subprocess.run(cmd,capture_output=True)\n+ (path/'heads.stdout').write_bytes(result.stdout);(path/'heads.stderr').write_bytes(result.stderr)\n+ if result.returncode:raise RuntimeError(repo+' origin read failed')\n+ refs={line.split()[1]:line.split()[0] for line in result.stdout.decode().splitlines()}\n+ head=refs[entry['origin_ref']]\n+ record=dict(repository=repo,pin=entry['commit'],origin_ref=entry['origin_ref'],current_origin_head=head,commands=[dict(command=cmd,exit_code=result.returncode)])\n+ if head!=entry['commit']:\n+  cmd=['gh','api','repos/cyberia-to/'+repo+'/compare/'+entry['commit']+'...'+head]\n+  result=subprocess.run(cmd,capture_output=True)\n+  (path/'comparison.stdout').write_bytes(result.stdout);(path/'comparison.stderr').write_bytes(result.stderr)\n+  record['commands'].append(dict(command=cmd,exit_code=result.returncode))\n+  if result.returncode:raise RuntimeError(repo+' origin ancestry read failed')\n+  data=json.loads(result.stdout)\n+  if data['status']!='ahead' or data['merge_base_commit']['sha']!=entry['commit']:raise ValueError(repo+' frozen commit no longer ancestor of selected origin ref')\n+  record['ancestry']=dict(status=data['status'],ahead_by=data['ahead_by'],merge_base_sha=data['merge_base_commit']['sha'])\n+ else:record['ancestry']=dict(status='identical')\n+ return record\n+with ThreadPoolExecutor(max_workers=4) as pool:rows=list(pool.map(run,spec['sources']))\n+report=dict(scope='Read-only historical frozen source reachability immediately after package draft upload; release/0.4 may advance independently',observed_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_sha256=spec['source_sha256'],status='passed',inputs=rows)\n+(OUT/'receipt.json').write_text(json.dumps(report,indent=2)+'\\n')\n+print(json.dumps({r['repository']:r['ancestry'] for r in rows},indent=2))"},{"sha":"ec0b32420107bce3712d5a61a28cc2c0ce72b9bf","filename":"audit/native-distribution-20261002/local-package-transport/check-origin-before-packages.py","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-before-packages.py","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-before-packages.py","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcheck-origin-before-packages.py?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1,30 @@\n+from pathlib import Path\n+from concurrent.futures import ThreadPoolExecutor\n+import datetime,json,subprocess\n+ROOT=Path(__file__).resolve().parent.parent\n+OUT=ROOT/'measurements/before-package-origin';OUT.mkdir()\n+spec=json.loads((ROOT/'trisha-native-ci/.github/native-rehearsal-source.json').read_text())\n+def run(entry):\n+ repo=entry['repository'];path=OUT/repo;path.mkdir()\n+ cmd=['git','-C',str(ROOT/repo),'ls-remote','--heads','origin']\n+ result=subprocess.run(cmd,capture_output=True)\n+ (path/'heads.stdout').write_bytes(result.stdout);(path/'heads.stderr').write_bytes(result.stderr)\n+ if result.returncode:raise RuntimeError(repo+' origin read failed')\n+ refs={line.split()[1]:line.split()[0] for line in result.stdout.decode().splitlines()}\n+ head=refs[entry['origin_ref']]\n+ record=dict(repository=repo,pin=entry['commit'],origin_ref=entry['origin_ref'],current_origin_head=head,commands=[dict(command=cmd,exit_code=result.returncode)])\n+ if head!=entry['commit']:\n+  cmd=['gh','api','repos/cyberia-to/'+repo+'/compare/'+entry['commit']+'...'+head]\n+  result=subprocess.run(cmd,capture_output=True)\n+  (path/'comparison.stdout').write_bytes(result.stdout);(path/'comparison.stderr').write_bytes(result.stderr)\n+  record['commands'].append(dict(command=cmd,exit_code=result.returncode))\n+  if result.returncode:raise RuntimeError(repo+' origin ancestry read failed')\n+  data=json.loads(result.stdout)\n+  if data['status']!='ahead' or data['merge_base_commit']['sha']!=entry['commit']:raise ValueError(repo+' frozen commit no longer ancestor of selected origin ref')\n+  record['ancestry']=dict(status=data['status'],ahead_by=data['ahead_by'],merge_base_sha=data['merge_base_commit']['sha'])\n+ else:record['ancestry']=dict(status='identical')\n+ return record\n+with ThreadPoolExecutor(max_workers=4) as pool:rows=list(pool.map(run,spec['sources']))\n+report=dict(scope='Read-only historical frozen source reachability immediately before package draft upload; release/0.4 may advance independently',observed_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_sha256=spec['source_sha256'],status='passed',inputs=rows)\n+(OUT/'receipt.json').write_text(json.dumps(report,indent=2)+'\\n')\n+print(json.dumps({r['repository']:r['ancestry'] for r in rows},indent=2))"},{"sha":"124b889f2fb20f66a150cce1d8179cc7c2c6d98b","filename":"audit/native-distribution-20261002/local-package-transport/corpus-after-tag.stderr","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stderr","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stderr","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stderr?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1 @@\n+gh: Not Found (HTTP 404)"},{"sha":"e385323ae2ea31cecf40d7935cfdda1ae80ca1e9","filename":"audit/native-distribution-20261002/local-package-transport/corpus-after-tag.stdout","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stdout","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stdout","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-package-transport%2Fcorpus-after-tag.stdout?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1 @@\n+{\"message\":\"Not Found\",\"documentation_url\":\"https://docs.github.com/rest/git/refs#get-a-reference\",\"status\":\"404\"}\n\\ No newline at end of file"},{"sha":"e69de29bb2d1d6434
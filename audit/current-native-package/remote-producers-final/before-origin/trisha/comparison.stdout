additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fbefore-origin.stdout","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fbefore-origin.stdout","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fbefore-origin.stdout?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1,43 @@\n+{\n+  \"bbg\": {\n+    \"status\": \"identical\"\n+  },\n+  \"hemera\": {\n+    \"status\": \"identical\"\n+  },\n+  \"honeycrisp\": {\n+    \"status\": \"identical\"\n+  },\n+  \"joy\": {\n+    \"status\": \"ahead\",\n+    \"ahead_by\": 8,\n+    \"merge_base_sha\": \"77fec58bd39f9e9cb1e957590831109439352e45\"\n+  },\n+  \"lens\": {\n+    \"status\": \"identical\"\n+  },\n+  \"neuron\": {\n+    \"status\": \"identical\"\n+  },\n+  \"nox\": {\n+    \"status\": \"ahead\",\n+    \"ahead_by\": 2,\n+    \"merge_base_sha\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\"\n+  },\n+  \"strata\": {\n+    \"status\": \"identical\"\n+  },\n+  \"trident\": {\n+    \"status\": \"identical\"\n+  },\n+  \"trisha\": {\n+    \"status\": \"ahead\",\n+    \"ahead_by\": 3,\n+    \"merge_base_sha\": \"d59738198aff278e7166e5958fbbc5f9777986b7\"\n+  },\n+  \"zheng\": {\n+    \"status\": \"ahead\",\n+    \"ahead_by\": 8,\n+    \"merge_base_sha\": \"633e5ba980db94ca10d9d6b67cf24d9d3aef63a7\"\n+  }\n+}"},{"sha":"2ec25c11e0d42b5ba3e0843bcab8a6338aeb4cfc","filename":"audit/native-distribution-20261002/local-evidence-transport/check-origin-after-evidence.py","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-after-evidence.py","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-after-evidence.py","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-after-evidence.py?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1,30 @@\n+from pathlib import Path\n+from concurrent.futures import ThreadPoolExecutor\n+import datetime,json,subprocess\n+ROOT=Path(__file__).resolve().parent.parent\n+OUT=ROOT/'measurements/after-evidence-origin';OUT.mkdir()\n+spec=json.loads((ROOT/'trisha-native-ci/.github/native-rehearsal-source.json').read_text())\n+def run(entry):\n+ repo=entry['repository'];path=OUT/repo;path.mkdir()\n+ cmd=['git','-C',str(ROOT/repo),'ls-remote','--heads','origin']\n+ result=subprocess.run(cmd,capture_output=True)\n+ (path/'heads.stdout').write_bytes(result.stdout);(path/'heads.stderr').write_bytes(result.stderr)\n+ if result.returncode:raise RuntimeError(repo+' origin read failed')\n+ refs={line.split()[1]:line.split()[0] for line in result.stdout.decode().splitlines()}\n+ head=refs[entry['origin_ref']]\n+ record=dict(repository=repo,pin=entry['commit'],origin_ref=entry['origin_ref'],current_origin_head=head,commands=[dict(command=cmd,exit_code=result.returncode)])\n+ if head!=entry['commit']:\n+  cmd=['gh','api','repos/cyberia-to/'+repo+'/compare/'+entry['commit']+'...'+head]\n+  result=subprocess.run(cmd,capture_output=True)\n+  (path/'comparison.stdout').write_bytes(result.stdout);(path/'comparison.stderr').write_bytes(result.stderr)\n+  record['commands'].append(dict(command=cmd,exit_code=result.returncode))\n+  if result.returncode:raise RuntimeError(repo+' origin ancestry read failed')\n+  data=json.loads(result.stdout)\n+  if data['status']!='ahead' or data['merge_base_commit']['sha']!=entry['commit']:raise ValueError(repo+' frozen commit no longer ancestor of selected origin ref')\n+  record['ancestry']=dict(status=data['status'],ahead_by=data['ahead_by'],merge_base_sha=data['merge_base_commit']['sha'])\n+ else:record['ancestry']=dict(status='identical')\n+ return record\n+with ThreadPoolExecutor(max_workers=4) as pool:rows=list(pool.map(run,spec['sources']))\n+report=dict(scope='Read-only historical frozen source reachability immediately after completed local evidence draft upload; release/0.4 may advance independently',observed_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_sha256=spec['source_sha256'],status='passed',inputs=rows)\n+(OUT/'receipt.json').write_text(json.dumps(report,indent=2)+'\\n')\n+print(json.dumps({r['repository']:r['ancestry'] for r in rows},indent=2))"},{"sha":"cae7f0f8b458a07b2723412e5c4bda143c1252e3","filename":"audit/native-distribution-20261002/local-evidence-transport/check-origin-before-evidence.py","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/cyberia-to/trisha/blob/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-before-evidence.py","raw_url":"https://github.com/cyberia-to/trisha/raw/68278000bc7941b8df74e6635925f7d08153360c/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-before-evidence.py","contents_url":"https://api.github.com/repos/cyberia-to/trisha/contents/audit%2Fnative-distribution-20261002%2Flocal-evidence-transport%2Fcheck-origin-before-evidence.py?ref=68278000bc7941b8df74e6635925f7d08153360c","patch":"@@ -0,0 +1,30 @@\n+from pathlib import Path\n+from concurrent.futures import ThreadPoolExecutor\n+import datetime,json,subprocess\n+ROOT=Path(__file__).resolve().parent.parent\n+OUT=ROOT/'measurements/before-evidence-origin';OUT.mkdir()\n+spec=json.loads((ROOT/'trisha-native-ci/.github/native-rehearsal-source.json').read_text())\n+def run(entry):\n+ repo=entry['repository'];path=OUT/repo;path.mkdir()\n+ cmd=['git','-C',str(ROOT/repo),'ls-remote','--heads','origin']\n+ result=subprocess.run(cmd,capture_output=True)\n+ (path/'heads.stdout').write_bytes(result.stdout);(path/'heads.stderr').write_bytes(result.stderr)\n+ if result.returncode:raise RuntimeError(repo+' origin read failed')\n+ refs={line.split()[1]:line.split()[0] for line in result.stdout.decode().splitlines()}\n+ head=refs[entry['origin_ref']]\n+ record=dict(repository=repo,pin=entry['commit'],origin_ref=entry['origin_ref'],current_origin_head=head,commands=[dict(command=cmd,exit_code=result.returncode)])\n+ if head!=entry['commit']:\n+  cmd=['gh','api','repos/cyberia-to/'+repo+'/compare/'+entry['commit']+'...'+head]\n+  result=subprocess.run(cmd,capture_output=True)\n+  (path/'comparison.stdout').write_bytes(result.stdout);(path/'comparison.stderr').write_bytes(result.stderr)\n+  record['commands'].append(dict(command=cmd,exit_code=result.returncode))\n+  if result.returncode:raise RuntimeError(repo+' origin ancestry read failed')\n+  data=json.loads(result.stdout)\n+  if data['status']!='ahead' or data['merge_base_commit']['sha']!=entry['commit']:raise ValueError(repo+' frozen commit no longer ancestor of selected origin ref')\n+  record['ancestry']=dict(status=data['status'],ahead_by=data['ahead_by'],merge_base_sha=data['merge_base_commit']['sha'])\n+ else:record['ancestry']=dict(status='identical')\n+ return record\n+with ThreadPoolExecutor(max_workers=4) as pool:rows=list(pool.map(run,spec['sources']))\n+report=dict(scope='Read-only historical frozen source reachability immediately before completed local evidence draft upload; release/0.4 may advance independently',observed_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_sha256=spec['source_sha256'],status='passed',inputs=rows)\n+(OUT/'receipt.json').write_text(json.dumps(report,indent=2)+'\\n')\n+print(json.dumps({r['repository']:r['ancestry'] for r in rows},indent=2))"},{"sha":"124b889f2fb20f66a150cce
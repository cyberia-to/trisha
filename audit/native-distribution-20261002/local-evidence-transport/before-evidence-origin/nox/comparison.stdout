,"raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fformat.stdout","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fformat.stdout?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6"},{"sha":"7c607ba81928f8e60fc08d27d0daa45a6f96e936","filename":"audit/arena-snapshots/golden-probe.lock","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.lock","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.lock","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fgolden-probe.lock?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,59 @@\n+# This file is automatically @generated by Cargo.\n+# It is not intended for manual editing.\n+version = 4\n+\n+[[package]]\n+name = \"cyber-hemera\"\n+version = \"0.3.1\"\n+\n+[[package]]\n+name = \"cyber-nox\"\n+version = \"0.3.0\"\n+dependencies = [\n+ \"cyber-hemera\",\n+ \"strata-nebu\",\n+]\n+\n+[[package]]\n+name = \"snapshot-v1-golden\"\n+version = \"0.0.0\"\n+dependencies = [\n+ \"cyber-hemera\",\n+ \"cyber-nox\",\n+ \"strata-nebu\",\n+]\n+\n+[[package]]\n+name = \"strata-compute\"\n+version = \"0.1.1\"\n+dependencies = [\n+ \"strata-core\",\n+]\n+\n+[[package]]\n+name = \"strata-core\"\n+version = \"0.1.1\"\n+\n+[[package]]\n+name = \"strata-ext\"\n+version = \"0.1.1\"\n+dependencies = [\n+ \"strata-core\",\n+]\n+\n+[[package]]\n+name = \"strata-nebu\"\n+version = \"0.1.1\"\n+dependencies = [\n+ \"strata-compute\",\n+ \"strata-core\",\n+ \"strata-ext\",\n+ \"strata-proof\",\n+]\n+\n+[[package]]\n+name = \"strata-proof\"\n+version = \"0.1.1\"\n+dependencies = [\n+ \"strata-core\",\n+]"},{"sha":"5175018b607b6e7a7ec74f18bd7a44ee1a7e3c18","filename":"audit/arena-snapshots/golden-probe.rs","status":"added","additions":64,"deletions":0,"changes":64,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.rs","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.rs","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fgolden-probe.rs?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,64 @@\n+use nox::{Reduction, Order};\n+use nox::sequential::{observe::*, CompactionLimits};\n+use nebu::Goldilocks;\n+fn atom<const N: usize>(ar: &mut Reduction<N>, v: u64) -> Order {\n+    ar.atom(Goldilocks::new(v)).unwrap()\n+}\n+fn op<const N: usize>(ar: &mut Reduction<N>, tag: u64, body: Order) -> Order {\n+    let t = atom(ar, tag);\n+    ar.pair(t, body).unwrap()\n+}\n+fn binary<const N: usize>(ar: &mut Reduction<N>, tag: u64, a: Order, b: Order) -> Order {\n+    let body = ar.pair(a, b).unwrap();\n+    op(ar, tag, body)\n+}\n+fn quote<const N: usize>(ar: &mut Reduction<N>, v: u64) -> Order {\n+    let v = atom(ar, v);\n+    op(ar, 1, v)\n+}\n+fn axis<const N: usize>(ar: &mut Reduction<N>, v: u64) -> Order {\n+    let v = atom(ar, v);\n+    op(ar, 0, v)\n+}\n+fn loop_core<const N: usize>(ar: &mut Reduction<N>, n: u64) -> (Order, Order) {\n+    let q0 = quote(ar, 0);\n+    let q1 = quote(ar, 1);\n+    let code = axis(ar, 2);\n+    let remaining = axis(ar, 6);\n+    let acc = axis(ar, 7);\n+    let done = binary(ar, 9, remaining, q0);\n+    let next = binary(ar, 6, remaining, q1);\n+    let acc_next = binary(ar, 5, acc, q1);\n+    let state = binary(ar, 3, next, acc_next);\n+    let subject = binary(ar, 3, code, state);\n+    let again = binary(ar, 2, subject, code);\n+    let arms = ar.pair(acc, again).unwrap();\n+    let formula = binary(ar, 4, done, arms);\n+    let zero = atom(ar, 0);\n+    let count = atom(ar, n);\n+    let state = ar.pair(count, zero).unwrap();\n+    (ar.pair(formula, state).unwrap(), formula)\n+}\n+\n+struct Digest { hash: hemera::Hasher }\n+impl Observer for Digest {\n+    type Error = ();\n+    fn record(&mut self, e: Event) -> Result<(), ()> {\n+        self.hash.update(e.encode().as_bytes());\n+        Ok(())\n+    }\n+}\n+fn main() {\n+    let mut ar = Reduction::<256>::new();\n+    let (object, formula) = loop_core(&mut ar, 40);\n+    assert!(ar.limit_allocations(100));\n+    let mut sink = Digest { hash: hemera::Hasher::new() };\n+    let run = reduce_compacting_observed_controlled(&mut ar, object, formula, 1000,\n+        CompactionLimits { max_frames: 4096, max_total_allocations: 100_000, max_collection_work: 100_000_000 },\n+        CaptureLimits { max_events: 1_000_000, max_bytes: 500_000_000, max_work: 4_000_000 },\n+        &mut sink, &mut || false).unwrap();\n+    println!(\"{:?}\", sink.hash.finalize().as_bytes());\n+    println!(\"{:?}\", run.capture);\n+    println!(\"{:?}\", run.execution.stats);\n+    println!(\"{:?}\", run.execution.outcome);\n+}"},{"sha":"6a1c30ee50d0a7df26d0ac67de6d2508cc191124","filename":"audit/arena-snapshots/golden-probe.toml","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.toml","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-probe.toml","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fgolden-probe.toml?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,12 @@\n+[package]\n+name = \"snapshot-v1-golden\"\n+version = \"0.0.0\"\n+edition = \"2024\"\n+[workspace]\n+[[bin]]\n+name = \"snapshot-v1-golden\"\n+path = \"main.rs\"\n+[dependencies]\n+nox = {package = \"cyber-nox\", path = \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/nox/rs\"}\n+nebu = {package = \"strata-nebu\", path = \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/strata/nebu/rs\"}\n+hemera = {package = \"cyber-hemera\", path = \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/hemera/rs\"}"},{"sha":"33ac7868c4d6c6266b54949049ecc08ac0a73e4f","filename":"audit/arena-snapshots/golden-v1-command.json","status":"added","additions":60,"deletions":0,"changes":60,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-v1-command.json","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-v1-command.json","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fgolden-v1-command.json?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,60 @@\n+{\n+  \"schema\": 1,\n+  \"scope\": \"pre-extension version-1 byte-stream golden; no proof acceptance\",\n+  \"command\": [\n+    \"/Users/master/.cargo/bin/rustup\",\n+    \"run\",\n+    \"1.89.0\",\n+    \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/cargo\",\n+    \"run\",\n+    \"--release\",\n+    \"--offline\",\n+    \"--manifest-path\",\n+    \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/golden-probe/Cargo.toml\"\n+  ],\n+  \"cwd\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/nox\",\n+  \"explicit_environment\": {\n+    \"CARGO_TARGET_DIR\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/golden-target\",\n+    \"CARGO_BUILD_JOBS\": \"2\",\n+    \"RUSTC\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/rustc\"\n+  },\n+  \"source_revision\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\",\n+  \"source_status\": \"\",\n+  \"toolchain\": {\n+    \"cargo\": {\n+      \"path\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-ap
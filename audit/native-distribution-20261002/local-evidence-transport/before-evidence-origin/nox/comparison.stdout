olden-v1.stdout","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fgolden-v1.stdout","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fgolden-v1.stdout?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,4 @@\n+[247, 224, 8, 81, 140, 212, 21, 213, 119, 4, 247, 94, 124, 162, 147, 214, 209, 213, 65, 23, 165, 192, 251, 229, 103, 82, 241, 203, 84, 99, 27, 97]\n+CaptureStats { events: 1383, bytes: 341960, work: 5183 }\n+CompactionStats { pinned_nodes: 32, resident_nodes: 43, peak_resident_nodes: 100, total_allocations: 171, reclaimed_nodes: 128, collections: 2, collection_work: 133415, scratch_bytes: 1424, evaluator_checkpoints: 1211, collection_checkpoints: 6 }\n+Ok(29, 395)"},{"sha":"817779f36601da7c21896b80438774955131b3a5","filename":"audit/arena-snapshots/root-review.json","status":"added","additions":56,"deletions":0,"changes":56,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Froot-review.json","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Froot-review.json","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Froot-review.json?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,56 @@\n+{\n+  \"schema\": 1,\n+  \"scope\": \"independent root review of observer v2 extension; no proof closure\",\n+  \"recorded_ns\": 1790905703401597000,\n+  \"reviewer\": \"/root\",\n+  \"base_revision\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\",\n+  \"files\": {\n+    \"specs/sequential-compaction.md\": {\n+      \"bytes\": 13357,\n+      \"sha256\": \"ba81952103b7e44a04ef16d3d6d5e0bf7906eadcda19c507742d3662e85c5fd9\"\n+    },\n+    \"rs/sequential/compacting.rs\": {\n+      \"bytes\": 9051,\n+      \"sha256\": \"9548eb023f10c8cb9ca4ab9b91e9dc18ae2993036174bcbbe3c187e5c6e3f3fb\"\n+    },\n+    \"rs/sequential/observe/mod.rs\": {\n+      \"bytes\": 6001,\n+      \"sha256\": \"97848d24492bceedd6a9d4b7033fbf15c0f841d16c3f867e63f6ec92e1b06fa3\"\n+    },\n+    \"rs/sequential/observe/hook.rs\": {\n+      \"bytes\": 2741,\n+      \"sha256\": \"6cecb7f08c84ce9d0131c722b64bbf88621cdae929ace524c043a4453c61fa19\"\n+    },\n+    \"rs/sequential/observe/capture.rs\": {\n+      \"bytes\": 10226,\n+      \"sha256\": \"f7fcde25606b16ed9ef48bdca6a50b8be380e45dd1b0610821b139b18287f688\"\n+    },\n+    \"rs/sequential/observe/stream.rs\": {\n+      \"bytes\": 1236,\n+      \"sha256\": \"a5181f23ad67281aef9a96d0bd16f05c08a4fdcc4d75f421d92331b49830fc37\"\n+    },\n+    \"rs/sequential/observe/v2.rs\": {\n+      \"bytes\": 1321,\n+      \"sha256\": \"2c5de680b20194891eb1c0b3f4d792a3813372b84aac609b4f698e2cc878ede3\"\n+    },\n+    \"rs/sequential/observe/wire.rs\": {\n+      \"bytes\": 6437,\n+      \"sha256\": \"257ce762cd5cd47991bfcbc66bd239b171ef5684bfc3ef8198a362ae7c50a2ae\"\n+    },\n+    \"rs/sequential/observe/tests.rs\": {\n+      \"bytes\": 13010,\n+      \"sha256\": \"19a77de778907445346b869795884c30ae6f10ba3701d60ded449f9c8230c6bc\"\n+    },\n+    \"rs/sequential/observe/tests/snapshots.rs\": {\n+      \"bytes\": 10496,\n+      \"sha256\": \"5c2d1d54661997f39aed5ad6f3f5d3b04dbe36a56d49d8e57cbcbafc1ad9aaa9\"\n+    },\n+    \"rs/sequential/observe/tests/snapshots/failures.rs\": {\n+      \"bytes\": 8978,\n+      \"sha256\": \"6f7d8d750a5354a0500ae27b975cf5a172f4d13e5a26324e0d30233e864b57fe\"\n+    }\n+  },\n+  \"production_review\": \"Reviewed full production diff and spec: hook placement, v1 adapter without reset or work, v2 prior-order snapshots, accounting and tagging. No findings.\",\n+  \"tests_review\": \"Reviewed positive and pre-extension golden tests, exact and one-below caps, partial snapshots, post-commit cancellation, failure at reset and each snapshot node, and failed collection. No findings.\",\n+  \"source_identity_check\": \"All reviewed source hashes equal final all-target check and workspace/all-features gate receipts.\"\n+}"},{"sha":"d05832dfda43807d799873331c4b49063b7f963c","filename":"audit/arena-snapshots/run.py","status":"added","additions":95,"deletions":0,"changes":95,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Frun.py","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Frun.py","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Frun.py?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,95 @@\n+\"\"\"Retain explicit Rust 1.89 snapshot gate commands, source maps and bounded logs.\"\"\"\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import signal\n+import subprocess\n+import sys\n+import time\n+\n+ROOT = Path(__file__).resolve().parents[2]\n+OUT = Path(__file__).resolve().parent\n+FAMILY = ROOT.parent\n+BIN = Path('/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin')\n+OWNED = ['specs/sequential-compaction.md', 'rs/sequential/compacting.rs',\n+         'rs/sequential/observe/mod.rs', 'rs/sequential/observe/hook.rs',\n+         'rs/sequential/observe/capture.rs', 'rs/sequential/observe/stream.rs',\n+         'rs/sequential/observe/v2.rs', 'rs/sequential/observe/wire.rs',\n+         'rs/sequential/observe/tests.rs', 'rs/sequential/observe/tests/snapshots.rs',\n+         'rs/sequential/observe/tests/snapshots/failures.rs']\n+\n+\n+def identity(path):\n+    raw = path.read_bytes()\n+    return dict(bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())\n+\n+\n+def git(path, *args):\n+    return subprocess.check_output(['git', '-C', str(path), *args], text=True).strip()\n+\n+\n+def sources():\n+    return dict(revision=git(ROOT, 'rev-parse', 'HEAD'),\n+                files={name: identity(ROOT / name) for name in OWNED if (ROOT / name).exists()},\n+                siblings={name: dict(path=str((FAMILY / name).resolve()),\n+                                     revision=git(FAMILY / name, 'rev-parse', 'HEAD'),\n+                                     status=git(FAMILY / name, 'status', '--porcelain'))\n+                          for name in ['strata', 'hemera', 'lens', 'honeycrisp']})\n+\n+\n+def rss_tree(pid):\n+    rows = [tuple(map(int, row.split())) for row in\n+            subprocess.check_output(['/bin/ps', '-axo', 'pid=,ppid=,rss='], text=True).splitlines()]\n+    selected = {pid}\n+    while True:\n+        following = selected | {child for child, parent, _ in rows if parent in selected}\n+        if following == selected:\n+            return sum(rss for child, _, rss in rows if child in selected)\n+        selected = following\n+\n+\n+kind = sys.argv[1]\n+assert len(sys.argv) == 2 or sys.argv[2].isdigit()\n+label = kind + ('-' + sys.argv[2] if len(sys.argv) > 2 else '')\n+commands = {\n+    'check': ['check', '--workspace', '--all-targets', '--release', '--locked', '--offline'],\n+    'focused': ['test', '-p', 'cyber-nox', '--lib', '--release', '--locked', '--offline',\n+                'sequential::observe', '--', '--nocapture', '--test-threads=2'],\n+    'workspace': ['test', '--workspace', '--release', '--locked', '--offline', '--', '--test-threads=2'],\n+    'all-features': ['test', '--workspace', '--all-features', '--release', '--locked', '--offline', '--', '--test-threads=2'],\n+}\n+argv = ['/Users/master/.cargo/bin/rustup', 'run', '1.89.0', str(BIN / 'cargo'), *commands[kind]]\n+env = dict(os.environ, PATH=str(BIN) + ':' + os.environ['PATH'], RUSTUP_TOOLCHAIN='1.89.0',\n+           RUSTC=str(BIN / 'rustc'), RUSTDOC=str(BIN / 'rustdoc'),\n+           CARGO_BUILD_JOBS='2', CARGO_TARGET_DIR=str(FAMILY / 'target'))\n+path = OUT / (label + '-command.json')\n+assert not path.exists()\n+report = dict(schema=1, scope='bounded observer snapshots; no proof acceptance', label=label,\n+              argv=argv, cwd=str(ROOT), started_ns=time.time_ns(),\n+              environment={key: value for key, value in env.items() if key == 'PATH' or key.startswith(('RUST', 'CARGO'))},\n+              toolchain={name: dict(path=str(BIN / name), **identity(BIN / name),\n+                                    version=subprocess.check_output([str(BIN / name), '--version', '--verbose'], env=env, text=True))\n+                         for name in ['cargo', 'rustc']}, sources_before=sources(),\n+              runner=identity(Path(__file__)), rss_limit_kib=2 * 1024 * 1024, rss_sampling_ms=250,\n+              log_limit_bytes=128 << 20, sampled_peak_tree_rss_kib=0, status='running')\n+with (OUT / (label + '.stdout')).open('xb') as stdout, (OUT / (label + '.stderr')).open('xb') as stderr:\n+    process = subprocess.Popen(argv, cwd=ROOT, env=env, stdout=stdout, stderr=stderr, start_new_session=True)\n+    while process.poll() is None:\n+        report['sampled_peak_tree_rss_kib'] = max(report['sampled_peak_tree_rss_kib'], rss_tree(process.pid))\n+        if report['sampled_peak_tree_rss_kib'] > report['rss_limit_kib'] or stdout.tell() + stderr.tell() > report['log_limit_bytes']:\n+            report['guard_failure'] = 'RSS or logs'\n+            os.killpg(process.pid, signal.SIGKILL)\n+        path.write_text(json.dumps(report, indent=2) + '\\n')\n+        time.sleep(0.25)\n+    report['exit_code'] = process.wait()\n+report.update(ended_ns=time.time_ns(), sources_after=sources(),\n+              stdout=identity(OUT / (label + '.stdout')), stderr=identity(OUT / (label + '.stderr')))\n+report['warning_lines'] = [line for suffix in ['stdout', 'stderr']\n+                           for line in (OUT / (label + '.' + suffix)).read_text().splitlines()\n+                           if line.startswith('warning:')]\n+report['status'] = ('passed' if report['exit_code'] == 0 and not report['warning_lines']\n+                    and 'guard_failure' not in report and report['sources_before'] == report['sources_after'] else 'failed')\n+path.write_text(json.dumps(report, indent=2) + '\\n')\n+print(json.dumps({key: report[key] for key in ['label', 'status', 'exit_code', 'sampled_peak_tree_rss_kib', 'warning_lines']}))\n+raise SystemExit(0 if report['status'] == 'passed' else 1)"},{"sha":"08012e0b96a963fb8bb8a2a96b00b58b980bb3d1","filename":"audit/arena-snapshots/workspace-command.json","status":"added","additions":204,"deletions":0,"changes":204,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fworkspace-command.json","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fworkspace-command.json","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fworkspace-command.json?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,204 @@\n+{\n+  \"schema\": 1,\n+  \"scope\": \"bounded observer snapshots; no proof acceptance\",\n+  \"label\": \"workspace\",\n+  \"argv\": [\n+    \"/Users/master/.cargo/bin/rustup\",\n+    \"run\",\n+    \"1.89.0\",\n+    \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/cargo\",\n+    \"test\",\n+    \"--workspace\",\n+    \"--release\",\n+    \"--locked\",\n+    \"--offline\",\n+    \"--\",\n+    \"--test-threads=2\"\n+  ],\n+  \"cwd\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/nox\",\n+  \"started_ns\": 1790905620970279000,\n+  \"environment\": {\n+    \"PATH\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin:/Users/master/.grok/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/opt/pkg/env/active/bin:/opt/pmk/env/global/bin:/opt/homebrew/bin:/Users/master/Library/Application Support/Zed/external_agents/registry/npx/codex-acp/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/codex-path:/Users/master/.codex/tmp/arg0/codex-arg00dVQaB:/Users/master/.cargo/bin:/Users/master/.foundry/bin\",\n+    \"RUSTUP_TOOLCHAIN\": \"1.89.0\",\n+    \"RUSTC\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/rustc\",\n+    \"RUSTDOC\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/rustdoc\",\n+    \"CARGO_BUILD_JOBS\": \"2\",\n+    \"CARGO_TARGET_DIR\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/target\"\n+  },\n+  \"toolchain\": {\n+    \"cargo\": {\n+      \"path\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/cargo\",\n+      \"bytes\": 28655992,\n+      \"sha256\": \"798a97c06e6fc3a63f1b7e3141f87e515e6bc8da1527bc32e19ba27d86bb89c5\",\n+      \"version\": \"cargo 1.89.0 (c24e10642 2025-06-23)\\nrelease: 1.89.0\\ncommit-hash: c24e1064277fe51ab72011e2612e556ac56addf7\\ncommit-date: 2025-06-23\\nhost: aarch64-apple-darwin\\nlibgit2: 1.9.0 (sys:0.20.2 vendored)\\nlibcurl: 8.7.1 (sys:0.4.80+curl-8.12.1 system ssl:(SecureTransport) LibreSSL/3.3.6)\\nssl: OpenSSL 3.5.0 8 Apr 2025\\nos: Mac OS 26.4.1 [64-bit]\\n\"\n+    },\n+    \"rustc\": {\n+      \"path\": \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/rustc\",\n+      \"bytes\": 414776,\n+      \"sha256\": \"af4a9eb303553510e9d74220636dc4b21f8574ddeab73741bf6b892adc49c21c\",\n+      \"version\": \"rustc 1.89.0 (29483883e 2025-08-04)\\nbinary: rustc\\ncommit-hash: 29483883eed69d5fb4db01964cdf2af4d86e9cb2\\ncommit-date: 2025-08-04\\nhost: aarch64-apple-darwin\\nrelease: 1.89.0\\nLLVM version: 20.1.7\\n\"\n+    }\n+  },\n+  \"sources_before\": {\n+    \"revision\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\",\n+    \"files\": {\n+      \"specs/sequential-compaction.md\": {\n+        \"bytes\": 13357,\n+        \"sha256\": \"ba81952103b7e44a04ef16d3d6d5e0bf7906eadcda19c507742d3662e85c5fd9\"\n+      },\n+      \"rs/sequential/compacting.rs\": {\n+        \"bytes\": 9051,\n+        \"sha256\": \"9548eb023f10c8cb9ca4ab9b91e9dc18ae2993036174bcbbe3c187e5c6e3f3fb\"\n+      },\n+      \"rs/sequential/observe/mod.rs\": {\n+        \"bytes\": 6001,\n+        \"sha256\": \"97848d24492bceedd6a9d4b7033fbf15c0f841d16c3f867e63f6ec92e1b06fa3\"\n+      },\n+      \"rs/sequential/observe/hook.rs\": {\n+        \"bytes\": 2741,\n+        \"sha256\": \"6cecb7f08c84ce9d0131c722b64bbf88621cdae929ace524c043a4453c61fa19\"\n+      },\n+      \"rs/sequential/observe/capture.rs\": {\n+        \"bytes\": 10226,\n+        \"sha256\": \"f7fcde25606b16ed9ef48bdca6a50b8be380e45dd1b0610821b139b18287f688\"\n+      },\n+      \"rs/sequential/observe/stream.rs\": {\n+        \"bytes\": 1236,\n+        \"sha256\": \"a5181f23ad67281aef9a96d0bd16f05c08a4fdcc4d75f421d92331b49830fc37\"\n+      },\n+      \"rs/sequential/observe/v2.rs\": {\n+        \"bytes\": 1321,\n+        \"sha256\": \"2c5de680b20194891eb1c0b3f4d792a3813372b84aac609b4f698e2cc878ede3\"\n+      },\n+      \"rs/sequential/observe/wire.rs\": {\n+        \"bytes\": 6437,\n+        \"sha256\": \"257ce762cd5cd47991bfcbc66bd239b171ef5684bfc3ef8198a362ae7c50a2ae\"\n+      },\n+      \"rs/sequential/observe/tests.rs\": {\n+        \"bytes\": 13010,\n+        \"sha256\": \"19a77de778907445346b869795884c30ae6f10ba3701d60ded449f9c8230c6bc\"\n+      },\n+      \"rs/sequential/observe/tests/snapshots.rs\": {\n+        \"bytes\": 10496,\n+        \"sha256\": \"5c2d1d54661997f39aed5ad6f3f5d3b04dbe36a56d49d8e57cbcbafc1ad9aaa9\"\n+      },\n+      \"rs/sequential/observe/tests/snapshots/failures.rs\": {\n+        \"bytes\": 8978,\n+        \"sha256\": \"6f7d8d750a5354a0500ae27b975cf5a172f4d13e5a26324e0d30233e864b57fe\"\n+      }\n+    },\n+    \"siblings\": {\n+      \"strata\": {\n+        \"path\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/strata\",\n+        \"revision\": \"d2eb1763b8caf04e6c7647ac6fe99761519c2ef9\",\n+        \"status\": \"\"\n+      },\n+      \"hemera\": {\n+        \"path\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/hemera\",\n+        \"revision\": \"a931a0a8e7ed369852ce0f8bc6451a59745ee692\",\n+        \"status\": \"\"\n+      },\n+      \"lens\": {\n+        \"path\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/lens\",\n+        \"revision\": \"17cafe91431977b738e5b72361187cd01ad93638\",\n+        \"status\": \"\"\n+      },\n+      \"honeycrisp\": {\n+        \"path\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/distribution/honeycrisp\",\n+        \"revision\": \"ff735e6c262926bc9bab7534786a575020cbe442\",\n+        \"status\": \"\"\n+      }\n+    }\n+  },\n+  \"runner\": {\n+    \"bytes\": 5391,\n+    \"sha256\": \"1752bbeeb9231a068bbd2f388bfca55754a03df6296584bf6f0c11c3ae6e73ef\"\n+  },\n+  \"rss_limit_kib\": 2097152,\n+  \"rss_sampling_ms\": 250,\n+  \"log_limit_bytes\": 134217728,\n+  \"sampled_peak_tree_rss_kib\": 401664,\n+  \"status\": \"passed\",\n+  \"exit_code\": 0,\n+  \"ended_ns\": 1790905631423569000,\n+  \"sources_after\": {\n+    \"revision\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\",\n+    \"files\": {\n+      \"specs/sequential-compaction.md\": {\n+        \"bytes\": 13357,\n+        \"sha256\": \"ba81952103b7e44a04ef16d3d6d5e0bf7906eadcda19c507742d3662e85c5fd9\"\n+      },\n+      \"rs/sequential/compacting.rs\": {\n+        \"bytes\": 9051,\n+        \"sha256\": \"9548eb023f10c8cb9ca4ab9b91e9dc18ae2993036174bcbbe3c187e5c6e3f3fb\"\n+      },\n+      \"rs/sequential/observe/mod.rs\": {\n+        \"bytes\": 6001,\n+        \"sha256\": \"97848d24492bceedd6a9d4b7033fbf15c0f841d16c3f867e63f6ec92e1b06fa3\"\n+      },\n+      \"rs/sequential/observe/hook.rs\": {\n+        \"bytes\": 2741,\n+        \"sha256\": \"6cecb7f08c84ce9d0131c722b64bbf88621cd
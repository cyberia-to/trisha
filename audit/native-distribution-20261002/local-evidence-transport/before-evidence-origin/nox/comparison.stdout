ct_capture_caps_pass_and_one_less_rejects_without_completion ... ok\n+test sequential::observe::tests::failures::execution_failures_keep_their_kinds_and_never_complete_capture ... ok\n+test sequential::observe::tests::failures::invalid_export_references_fail_closed_without_changing_legacy_behavior ... ok\n+test sequential::observe::tests::failures::sink_failure_at_every_delivery_leaves_only_accepted_prefix ... ok\n+test sequential::observe::tests::failures::zero_caps_stop_before_export_and_initial_export_is_cancellable ... ok\n+test sequential::observe::tests::relocation_changes_physical_orders_without_changing_logical_transitions ... ok\n+test sequential::observe::tests::snapshots::failures::cancellation_after_collection_commit_exports_no_reset_and_leaves_valid_arena ... ok\n+test sequential::observe::tests::differential::observed_all_pure_patterns_match_unobserved_values_failures_and_physical_reports ... ok\n+test sequential::observe::tests::snapshots::failures::failed_collection_exports_no_reset ... ok\n+test sequential::observe::tests::snapshots::failures::caps_and_cancellation_interrupt_snapshot_without_a_following_transition ... ok\n+test sequential::observe::tests::snapshots::failures::snapshot_caps_admit_exact_totals_and_reject_one_less_without_completion ... ok\n+test sequential::observe::tests::snapshots::pending_parent_inputs_can_disappear_from_later_arena_epochs ... ok\n+test sequential::observe::tests::snapshots::snapshots_preserve_runtime_stats_logical_steps_and_version_one_bytes ... ok\n+test sequential::observe::tests::snapshots::failures::sink_failure_at_reset_or_each_snapshot_node_keeps_only_accepted_prefix ... ok\n+test sequential::observe::tests::snapshots::version_two_reset_has_a_distinct_tag_without_wrapping_ordinary_bytes ... ok\n+test sequential::observe::tests::snapshots::version_two_without_collection_only_changes_begin_version ... ok\n+test sequential::observe::tests::wire::encoding_has_fixed_tags_little_endian_words_and_no_padding ... ok\n+test sequential::observe::tests::snapshots::version_one_gc_stream_matches_pre_extension_golden ... ok\n+\n+test result: ok. 21 passed; 0 failed; 0 ignored; 0 measured; 225 filtered out; finished in 0.13s\n+"},{"sha":"8278d723c4b4b087361f5a4f8c1b6f37f13c3dc9","filename":"audit/arena-snapshots/format-command.json","status":"added","additions":106,"deletions":0,"changes":106,"blob_url":"https://github.com/cyberia-to/nox/blob/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fformat-command.json","raw_url":"https://github.com/cyberia-to/nox/raw/2f09ca3c3f18ae470365310cca8db5208eda75c6/audit%2Farena-snapshots%2Fformat-command.json","contents_url":"https://api.github.com/repos/cyberia-to/nox/contents/audit%2Farena-snapshots%2Fformat-command.json?ref=2f09ca3c3f18ae470365310cca8db5208eda75c6","patch":"@@ -0,0 +1,106 @@\n+{\n+  \"argv\": [\n+    \"/Users/master/.rustup/toolchains/1.89.0-aarch64-apple-darwin/bin/rustfmt\",\n+    \"--check\",\n+    \"--edition\",\n+    \"2024\",\n+    \"--config\",\n+    \"skip_children=true\",\n+    \"rs/sequential/compacting.rs\",\n+    \"rs/sequential/observe/mod.rs\",\n+    \"rs/sequential/observe/hook.rs\",\n+    \"rs/sequential/observe/capture.rs\",\n+    \"rs/sequential/observe/stream.rs\",\n+    \"rs/sequential/observe/v2.rs\",\n+    \"rs/sequential/observe/wire.rs\",\n+    \"rs/sequential/observe/tests.rs\",\n+    \"rs/sequential/observe/tests/snapshots.rs\",\n+    \"rs/sequential/observe/tests/snapshots/failures.rs\"\n+  ],\n+  \"cwd\": \"/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002/observe/nox\",\n+  \"source_map\": {\n+    \"revision\": \"172811b7746cdcd6ab198a3ed976dc6c19f55d5b\",\n+    \"files\": {\n+      \"specs/sequential-compaction.md\": {\n+        \"bytes\": 13357,\n+        \"sha256\": \"ba81952103b7e44a04ef16d3d6d5e0bf7906eadcda19c507742d3662e85c5fd9\"\n+      },\n+      \"rs/sequential/compacting.rs\": {\n+        \"bytes\": 9051,\n+        \"sha256\": \"9548eb023f10c8cb9ca4ab9b91e9
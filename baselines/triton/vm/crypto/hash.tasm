// Canonical source ABI: first argument deepest; last result coordinate on top.

vm_crypto_hash__tip5:
    swap 9
    swap 8
    swap 1
    swap 8
    swap 7
    swap 2
    swap 7
    swap 6
    swap 3
    swap 6
    swap 5
    swap 4
    swap 5
    hash
    swap 4
    swap 3
    swap 1
    swap 3
    return

vm_crypto_hash__sponge_init:
    sponge_init
    return

vm_crypto_hash__sponge_absorb:
    swap 9
    swap 8
    swap 1
    swap 8
    swap 7
    swap 2
    swap 7
    swap 6
    swap 3
    swap 6
    swap 5
    swap 4
    swap 5
    sponge_absorb
    return

vm_crypto_hash__sponge_squeeze:
    sponge_squeeze
    swap 9
    swap 8
    swap 1
    swap 8
    swap 7
    swap 2
    swap 7
    swap 6
    swap 3
    swap 6
    swap 5
    swap 4
    swap 5
    return

vm_crypto_hash__sponge_absorb_mem:
    push 0
    push 0
    push 0
    push 0
    swap 4
    sponge_absorb_mem
    pop 5
    return

program baseline_quantum_cnot
use std.quantum.gates
fn main() { let state=gates.TwoQubit { q00: gates.Complex { re: 1, im: 2 }, q01: gates.Complex { re: 3, im: 4 }, q10: gates.Complex { re: 5, im: 6 }, q11: gates.Complex { re: 7, im: 8 } } let result=gates.cnot(state) pub_write(result.q00.re) pub_write(result.q00.im) pub_write(result.q01.re) pub_write(result.q01.im) pub_write(result.q10.re) pub_write(result.q10.im) pub_write(result.q11.re) pub_write(result.q11.im) }

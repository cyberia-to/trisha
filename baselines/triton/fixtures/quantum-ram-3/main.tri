program quantum_ram
use std.quantum.gates
use vm.io.mem
fn main(){
mem.write(99,987)
mem.write(100,3)
mem.write(101,6)
mem.write(102,9)
mem.write(103,12)
mem.write(104,15)
mem.write(105,18)
mem.write(106,21)
mem.write(107,24)
mem.write(108,27)
mem.write(109,30)
mem.write(110,33)
mem.write(111,36)
mem.write(112,39)
mem.write(113,42)
mem.write(114,45)
mem.write(115,48)
mem.write(116,654)
let addr:Field=pub_read()
let n:Field=pub_read()
let target:Field=pub_read()
gates.apply_single_gate(addr,n,target,gates.Complex{re:2,im:3},gates.Complex{re:5,im:7},gates.Complex{re:11,im:13},gates.Complex{re:17,im:19})
pub_write(mem.read(99))
pub_write(mem.read(100))
pub_write(mem.read(101))
pub_write(mem.read(102))
pub_write(mem.read(103))
pub_write(mem.read(104))
pub_write(mem.read(105))
pub_write(mem.read(106))
pub_write(mem.read(107))
pub_write(mem.read(108))
pub_write(mem.read(109))
pub_write(mem.read(110))
pub_write(mem.read(111))
pub_write(mem.read(112))
pub_write(mem.read(113))
pub_write(mem.read(114))
pub_write(mem.read(115))
pub_write(mem.read(116))
}

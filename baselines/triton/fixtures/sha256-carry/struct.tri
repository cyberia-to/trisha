program sha256_aggregate
use std.crypto.sha256
fn main() {
let w0 = as_u32(pub_read())
let w1 = as_u32(pub_read())
let w2 = as_u32(pub_read())
let w3 = as_u32(pub_read())
let w4 = as_u32(pub_read())
let w5 = as_u32(pub_read())
let w6 = as_u32(pub_read())
let w7 = as_u32(pub_read())
let w8 = as_u32(pub_read())
let w9 = as_u32(pub_read())
let w10 = as_u32(pub_read())
let w11 = as_u32(pub_read())
let w12 = as_u32(pub_read())
let w13 = as_u32(pub_read())
let w14 = as_u32(pub_read())
let w15 = as_u32(pub_read())
let d=sha256.double_sha256_single_block(w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15)
pub_write(as_field(d.h0))
pub_write(as_field(d.h1))
pub_write(as_field(d.h2))
pub_write(as_field(d.h3))
pub_write(as_field(d.h4))
pub_write(as_field(d.h5))
pub_write(as_field(d.h6))
pub_write(as_field(d.h7))
}

program compiler_pipeline_fixture
use vm.io.mem
use vm.core.convert
use std.compiler.pipeline
fn main() {
let n = pub_read()
assert(convert.as_u32(n) < convert.as_u32(1025))
for i in 0..n bounded 1024 { mem.write(1000 + convert.as_field(i), pub_read()) }
mem.write(2000 + 0,1000)
mem.write(2000 + 1,n)
mem.write(2000 + 4,1)
mem.write(2000 + 5,5)
mem.write(2000 + 6,10)
mem.write(2000 + 7,3)
mem.write(2000 + 8,16)
mem.write(2000 + 9,1073741824)
mem.write(2000 + 10,100000)
pipeline.compile(2000)
assert(mem.read(2011) == 0)
let count = mem.read(2003)
let base = mem.read(2002)
pub_write(count)
pub_write(0)
for i in 0..count bounded 1024 {
pub_write(mem.read(base + convert.as_field(i) * 4 + 0))
pub_write(mem.read(base + convert.as_field(i) * 4 + 1))
pub_write(mem.read(base + convert.as_field(i) * 4 + 2))
pub_write(mem.read(base + convert.as_field(i) * 4 + 3))
}
}

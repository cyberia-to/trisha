// Actual2-of3 dispatch; hashes are canonical. Expected-key policy remains in the example contract.
os_neptune_locks_multisig__verify_key:
    swap 1
    push 0
    push 0
    push 0
    push 0
    push 0
    push 0
    push 0
    push 0
    push 0
    swap 9
    swap 1
    swap 8
    swap 1
    swap 2
    swap 7
    swap 2
    swap 3
    swap 6
    swap 3
    swap 4
    swap 5
    swap 4
    hash
    swap 4
    swap 1
    swap 3
    swap 1
    pop 4
    eq
    assert
    return

os_neptune_locks_multisig__main:
    divine 5
    pop 4
    divine 5
    pop 4
    divine 5
    pop 4
    divine 1
    dup 0
    push 3
    eq
    dup 1
    push 5
    eq
    add
    dup 1
    push 6
    eq
    add
    assert
    dup 0
    push 3
    eq
    skiz
    call __mask3
    dup 0
    push 5
    eq
    skiz
    call __mask5
    dup 0
    push 6
    eq
    skiz
    call __mask6
    pop 4
    read_io 5
    pop 5
    return

__mask3:
    divine 1
    dup 4
    call os_neptune_locks_multisig__verify_key
    divine 1
    dup 3
    call os_neptune_locks_multisig__verify_key
    return

__mask5:
    divine 1
    dup 4
    call os_neptune_locks_multisig__verify_key
    divine 1
    dup 2
    call os_neptune_locks_multisig__verify_key
    return

__mask6:
    divine 1
    dup 3
    call os_neptune_locks_multisig__verify_key
    divine 1
    dup 2
    call os_neptune_locks_multisig__verify_key
    return
